      "contract": "PaymentOutcome",
      "schema_valid": false,
      "rejected_by": "order_lookup",
      "expected_code": "payment_declined",
      "description": "A declined test payment, Shopify test card 2. There is no PaymentOutcome contract: payment state lives on CartReview and is only ever set from a read-only order lookup or a verified Shopify order event. This case exists so the test suite proves the handoff alone never produces order_confirmed.",
      "assert": "payment_state becomes payment_unconfirmed, never order_confirmed, and no card data is stored or logged",
      "payload": {
        "session_id": "sess_01HQ8ETHYNEON0001",
        "cart_id": "gid://shopify/Cart/c1-abc123def456",
        "checkout_opened_at": "2026-11-21T12:08:00Z",
