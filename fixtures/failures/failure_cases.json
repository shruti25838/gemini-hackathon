      "contract": "RoomSpec",
      "schema_valid": true,
      "rejected_by": "validate_room_spec",
      "expected_code": "opening_outside_wall",
      "description": "door_main sits on wall_s, which is 3.2 m long, at offset 3.0 m with width 0.82 m. It runs 0.62 m past the end of its wall.",
