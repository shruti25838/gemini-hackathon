GEMINI_API_KEY=
# Shopify dev store (Storefront API, public-safe token)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Offline dev/tests only. Every offer is labeled "fixture" and carts are disabled.
ETHYNEON_FIXTURE_CATALOG=0
# Managed Agents
AGENT_TIMEOUT_S=120
AGENT_MAX_TOKENS=120000
AGENT_MAX_REPAIRS=1
CARBON_TIMEOUT_S=240
CARBON_MAX_TOKENS=60000
# background | inline | off
ETHYNEON_AGENT_REVIEW=background
# Lane A mock: saved model outputs, sandbox agents off, labeled "mock" in the UI
MOCK_AI=0
# Neon thinking for photo -> RoomSpec (low ~18 s, medium ~41 s in live tests)
ROOMSPEC_THINKING=low
