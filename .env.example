# Ethyneon environment. Copy to .env and fill in. .env is git-ignored.
# Every variable the app reads is listed here, with no values.
# Nothing secret belongs in web/: the browser never sees these.

# --------------------------------------------------------------------------
# Mock flags. 1 turns the mock on, 0 turns it off.
# A mock returns data in the exact contract format and is validated by the
# same tests as real data. A mock result is always labelled and never looks live.
# --------------------------------------------------------------------------
MOCK_AI=1
MOCK_COMMERCE=1
MOCK_ROOM_INPUT=1
MOCK_AGORA=1

# --------------------------------------------------------------------------
# Gemini and ADK (lane A)
# Model identifiers are verified and live in ai/model_ids.py. All six the PRD
# names were confirmed against this key: gemini-4-neon, gemini-4-hydrogen,
# gemini-4-argon, gemini-4-carbon, gemini-decision-1 and gemini-3.8-live.
# --------------------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
ADK_MODEL_ROOM=
ADK_MODEL_CATALOG=
ADK_MODEL_LIVE=
ADK_MODEL_DECISION=
MANAGED_AGENT_ARGON=
MANAGED_AGENT_CARBON=
AGENT_TOKEN_BUDGET_PER_RUN=

# Decisions API. google-genai 2.33.0 has no .decisions client (the guide's
# >=3.2.0 does not exist on PyPI), so it is called over plain HTTP at v1beta.
GEMINI_DECISIONS_BASE_URL=
GEMINI_DECISIONS_MODEL=

# --------------------------------------------------------------------------
# Shopify Storefront API (lane C). The development store is the only
# purchasable path, and only in test mode.
# --------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=
SHOPIFY_DIMENSION_METAFIELD_NAMESPACE=
SHOPIFY_DIMENSION_METAFIELD_WIDTH=
SHOPIFY_DIMENSION_METAFIELD_DEPTH=
SHOPIFY_DIMENSION_METAFIELD_HEIGHT=

# Live cart writes on the development store. Off by default and gated twice:
# this flag must be 1 AND SHOPIFY_STORE_DOMAIN must appear in the allowlist.
# Payment details never touch this app; checkout is hosted by Shopify in test
# mode.
LIVE_CART_WRITES=0
ALLOWED_CART_STORE_DOMAINS=

# Order confirmation only, behind this flag. Payment is never inferred from
# the checkout handoff. Phase 4 adds the read-only order-lookup credential,
# which must be separate from the Storefront token.
ENABLE_ORDER_LOOKUP=0
SHOPIFY_ORDER_LOOKUP_TOKEN=

# --------------------------------------------------------------------------
# Shop MCP (lane C, discovery only)
# The endpoint, transport and required headers are not documented on the
# official pages. The working recipe is in docs/SHOP_MCP_NOTES.md.
# Discovery results can never reach a cart.
# --------------------------------------------------------------------------
SHOP_MCP=1
SHOP_MCP_ENDPOINT=
SHOP_MCP_PROTOCOL_VERSION=
SHOP_MCP_TIMEOUT_SECONDS=
SHOP_MCP_CACHE_TTL_MS_OVERRIDE=

# --------------------------------------------------------------------------
# Agora (lane B)
# --------------------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=

# --------------------------------------------------------------------------
# Backend
# --------------------------------------------------------------------------
ETHYNEON_DB_PATH=
ETHYNEON_HOST=
ETHYNEON_PORT=
ETHYNEON_LOG_LEVEL=
ETHYNEON_CORS_ORIGINS=
APPROVAL_TTL_SECONDS=
CHECKOUT_AUDIT_TTL_SECONDS=

# --------------------------------------------------------------------------
# Fit engine. Pure geometry, no network. These tune the checks.
# --------------------------------------------------------------------------
FIT_CLEARANCE_MARGIN_M=
FIT_MIN_WALKWAY_WIDTH_M=
FIT_DOOR_SWING_STEPS=
