# Shared only between the three Ethyneon backends. Generate with openssl rand -hex 32.
ETHYNEON_CONNECTION_TOKEN=

# API key created in the temporary hackathon account's AI Studio project.
GEMINI_API_KEY=

# Both values come from the same certificate-enabled Agora project.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Comma-separated canonical Shopify store domains. Leave empty for public Shop discovery.
SHOPIFY_SHOPS=

# Optional development-store domain and public Storefront access token for product media.
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
